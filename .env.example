# Environment Variables Example for NeighborGrid
# Copy this to .env for local development

# Secret key for signing session cookies
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production

# Port for Flask/Gunicorn server
PORT=5000

# Optional custom database path (defaults to neighborgrid.db in root)
DATABASE_PATH=neighborgrid.db

# Flask environment: development / production
FLASK_ENV=development
